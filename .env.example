# Application Configuration
APP_NAME=Urbankinda
APP_ENV=development
DEBUG=true

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database
DATABASE_URL=sqlite:///./urbankinda.db
# For PostgreSQL: postgresql://user:password@localhost/urbankinda

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Data Providers (API Keys)
YAHOO_FINANCE_API_KEY=
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# NSE/BSE Data Source
NSE_DATA_PROVIDER=yahoo  # Options: yahoo, zerodha, nse_direct, cache
BSE_DATA_PROVIDER=yahoo

# News API Keys
NEWS_API_KEY=
TWITTER_API_KEY=
SENTIMENT_MODEL=vader  # Options: vader, transformers

# ML/RL Configuration
ML_MODEL_PATH=models/ml_models/
RL_MODEL_PATH=models/rl_models/
USE_GPU=false
MODEL_UPDATE_INTERVAL_HOURS=24

# Signal Configuration
SIGNAL_REFRESH_INTERVAL_SECONDS=60
MIN_SIGNAL_QUALITY=70
MIN_CONFIDENCE=0.60
MAX_DAILY_SIGNALS=50

# Risk Management
DEFAULT_ACCOUNT_RISK_PERCENT=1.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_CORRELATION=0.7

# Data Quality & Freshness
MIN_DATA_QUALITY_SCORE=0.8
MAX_DATA_STALENESS_MINUTES=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/urbankinda.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Caching
CACHE_TTL_SECONDS=300
CACHE_STRATEGY_TTL=3600
CACHE_BACKTEST_TTL=86400

# Backtesting & Validation
WALK_FORWARD_WINDOW_DAYS=90
WALK_FORWARD_STEP_DAYS=30
MIN_TRADES_FOR_STRATEGY=20
MIN_ROBUSTNESS_SCORE=0.65

# Live Monitoring
MONITOR_ACTIVE_SIGNALS=true
MONITOR_INTERVAL_SECONDS=30
MONITOR_MAX_WORKERS=5

# Email Alerts (optional)
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_RECIPIENT=

# Security
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
API_RATE_LIMIT=1000

# Feature Flags
FEATURE_OPTIONS_ENGINE=false
FEATURE_CROSS_ASSET_ENGINE=true
FEATURE_FUNDAMENTAL_ENGINE=true
FEATURE_EVENT_DETECTION=true
FEATURE_NEWS_SENTIMENT=true
FEATURE_RL_ENSEMBLE=true

# Market Hours (IST)
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_TIMEZONE=Asia/Kolkata
